# Backend local config (copy to .env, gitignored).
PORT=3001
DATABASE_URL=postgresql://kasakame:kasakame@localhost:5432/kasakame
# JWT secret (generate with: openssl rand -hex 32).
SESSION_SECRET=change-me
# Frontend host exactly as the browser sees it (port included): wallets hash it into ARC-60 auth data.
APP_DOMAIN=localhost:5173
APP_URI=http://localhost:5173
# Pinata JWT for server-side IPFS pinning (POST /uploads); create one at https://app.pinata.cloud/developers/api-keys.
PINATA_JWT=change-me
