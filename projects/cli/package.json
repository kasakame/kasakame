{
  "name": "@kasakame/cli",
  "version": "0.1.0",
  "author": {
    "name": "Alessio Di Domenico",
    "email": "alessio.661@hotmail.it"
  },
  "type": "module",
  "description": "Escape-hatch CLI for kasakame: refund, withdraw, claim, delete, and clean up campaigns by app ID",
  "keywords": [
    "algorand",
    "algorand-blockchain",
    "algokit",
    "algosdk",
    "blockchain",
    "cli",
    "crowdfunding",
    "dapp",
    "kasakame",
    "walletconnect"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasakame/kasakame.git",
    "directory": "projects/cli"
  },
  "homepage": "https://github.com/kasakame/kasakame/tree/main/projects/cli#readme",
  "bugs": {
    "url": "https://github.com/kasakame/kasakame/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0"
  },
  "bin": {
    "kasakame": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run --exclude 'test/**'",
    "test:watch": "vitest --exclude 'test/**'",
    "test:coverage": "vitest run --coverage --exclude 'test/**'",
    "test:integration": "npm run build && vitest run --no-file-parallelism test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.0.0",
    "@algorandfoundation/xhd-wallet-api": "^1.0.3",
    "@kasakame/sdk": "^0.2.0",
    "@perawallet/walletconnect": "^1.0.3",
    "algosdk": "^3.9.0",
    "bip39": "^3.1.2",
    "libsodium-wrappers-sumo": "0.7.15",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@kasakame/constants": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kasakame/constants": "file:../constants",
    "@kasakame/contracts": "^0.2.0",
    "@kasakame/utils": "file:../utils",
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.3.11",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.5"
  }
}
