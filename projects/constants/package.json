{
  "name": "@kasakame/constants",
  "version": "0.2.0",
  "author": {
    "name": "Alessio Di Domenico",
    "email": "alessio.661@hotmail.it"
  },
  "type": "module",
  "description": "Shared protocol, product, fee, and AVM constants for kasakame",
  "keywords": [
    "algorand",
    "algorand-blockchain",
    "algokit",
    "avm",
    "smart-contracts",
    "constants",
    "puya",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasakame/kasakame.git",
    "directory": "projects/constants"
  },
  "homepage": "https://github.com/kasakame/kasakame/tree/main/projects/constants#readme",
  "bugs": {
    "url": "https://github.com/kasakame/kasakame/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2"
  }
}
