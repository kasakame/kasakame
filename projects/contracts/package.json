{
  "name": "@kasakame/contracts",
  "version": "0.2.0",
  "author": {
    "name": "Alessio Di Domenico",
    "email": "alessio.661@hotmail.it"
  },
  "description": "Compiled kasakame contract artifacts: ARC-56, ARC-32, TEAL, and Puya source maps",
  "keywords": [
    "algorand",
    "algorand-blockchain",
    "algokit",
    "arc56",
    "arc32",
    "teal",
    "puya",
    "smart-contracts",
    "contract-artifacts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasakame/kasakame.git",
    "directory": "projects/contracts"
  },
  "homepage": "https://github.com/kasakame/kasakame/tree/main/projects/contracts#readme",
  "bugs": {
    "url": "https://github.com/kasakame/kasakame/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "algokit compile ts smart_contracts --output-source-map --out-dir artifacts && algokit generate client smart_contracts/artifacts --output {app_spec_dir}/{contract_name}Client.ts",
    "prepack": "node scripts/packaging/stage-package.ts",
    "test:pack": "node scripts/packaging/check-package.ts",
    "deploy:localnet": "tsx --env-file-if-exists=.env.localnet deploy/index.ts",
    "deploy:localnet:watch": "tsx watch --env-file-if-exists=.env.localnet deploy/index.ts",
    "deploy:testnet": "tsx --env-file-if-exists=.env.testnet deploy/index.ts",
    "deploy:mainnet": "tsx --env-file-if-exists=.env.mainnet deploy/index.ts",
    "seed:localnet": "tsx --env-file-if-exists=.env.localnet scripts/demo/seed.ts",
    "seed:testnet": "tsx --env-file-if-exists=.env.testnet scripts/demo/seed.ts",
    "unseed:localnet": "tsx --env-file-if-exists=.env.localnet scripts/demo/unseed.ts",
    "unseed:testnet": "tsx --env-file-if-exists=.env.testnet scripts/demo/unseed.ts",
    "localnet:advance": "tsx --env-file-if-exists=.env.localnet scripts/advance-time.ts",
    "localnet:fund": "tsx --env-file-if-exists=.env.localnet scripts/fund-account.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run --no-color --exclude 'test/**/*.test.ts' --exclude '**/08-size-budget.spec.ts'",
    "test:integration": "vitest run --no-color --no-file-parallelism test --exclude 'test/**/*.spec.ts' --exclude 'test/99-*.test.ts'",
    "test:size": "vitest run --no-color test/08-size-budget.spec.ts",
    "test:all": "vitest run --no-color --exclude 'test/99-*.test.ts'",
    "test:coverage": "vitest run --no-color --coverage --exclude 'test/**/*.test.ts' --exclude '**/08-size-budget.spec.ts'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:cap:failed": "vitest run --no-color test/99-cap-failed.test.ts",
    "test:cap:claimed": "vitest run --no-color test/99-cap-claimed.test.ts"
  },
  "devDependencies": {
    "@algorandfoundation/algorand-typescript": "^1.0.1",
    "@algorandfoundation/algokit-client-generator": "^6.0.2",
    "@algorandfoundation/algokit-utils": "^9.2.3",
    "@algorandfoundation/algokit-utils-debug": "^1.0.4",
    "@algorandfoundation/algorand-typescript-testing": "^1.2.0",
    "@algorandfoundation/puya-ts": "^1.0.1",
    "@algorandfoundation/xhd-wallet-api": "^1.0.3",
    "@eslint/js": "^9.39.5",
    "@kasakame/constants": "file:../constants",
    "@kasakame/utils": "file:../utils",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node24": "^24.0.6",
    "@vitest/coverage-v8": "^5.1.1",
    "algosdk": "^3.0.0",
    "bip39": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "0.25.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "libsodium-sumo": "0.8.4"
  }
}
