# TestNet: `algokit project bootstrap all` creates this file from the template.

# Deployer: a 25-word Algo25 mnemonic, or a 24-word Pera passphrase plus the matching DEPLOYER_ADDRESS.
DEPLOYER_ADDRESS=
DEPLOYER_MNEMONIC=

# Algod and indexer. The defaults below are the public AlgoNode endpoints.
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=
INDEXER_SERVER=https://testnet-idx.algonode.cloud
INDEXER_PORT=443
INDEXER_TOKEN=

# Required on TestNet: the treasury that receives unclaimed refunds after the window.
SWEEP_TARGET=
# Optional: refund window in seconds (default 730 days, minimum 30 days, maximum 10 years).
REFUND_WINDOW_SECONDS=

# Optional `npm run seed:testnet` accounts (pre-funded); LocalNet seeds from KMD instead.
# BACKER_A_MNEMONIC=
# BACKER_B_MNEMONIC=
# ALICE_MNEMONIC=
# BOB_MNEMONIC=
# CAROL_MNEMONIC=
# DAVE_MNEMONIC=

# `npm run deploy:testnet` prints the app ids to save here and in the frontend `.env.testnet`.
REGISTRY_APP_ID=
VAULT_APP_ID=
