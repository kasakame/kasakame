# TestNet environment. `algokit project bootstrap all` creates the matching `.env.testnet`
# (gitignored) from this file when it is missing.
#
# Deployer: a 25-word Algo25 mnemonic, or a 24-word Pera Universal Wallet passphrase with
# DEPLOYER_ADDRESS set to the account it derives. `algokit dispenser fund` tops up the address.
DEPLOYER_ADDRESS=
DEPLOYER_MNEMONIC=

# Algod and indexer. The defaults below are the public AlgoNode endpoints.
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=
INDEXER_SERVER=https://testnet-idx.algonode.cloud
INDEXER_PORT=443
INDEXER_TOKEN=

# Required on TestNet: the treasury that receives unclaimed refunds after the window.
SWEEP_TARGET=
# Optional: refund window in seconds (default 730 days, maximum 10 years).
REFUND_WINDOW_SECONDS=

# Optional `npm run seed:testnet` accounts (pre-funded); LocalNet seeds from KMD instead.
# BACKER_A_MNEMONIC=
# BACKER_B_MNEMONIC=
# ALICE_MNEMONIC=
# BOB_MNEMONIC=
# CAROL_MNEMONIC=
# DAVE_MNEMONIC=

# `npm run deploy:testnet` deploys the Factory then the ClaimsVault and prints both app ids.
# Save them here for the seed/deploy scripts and in `projects/frontend/.env.testnet` for the dApp.
FACTORY_APP_ID=
VAULT_APP_ID=
