    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.14.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.10.0",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.2.3",
    "@kasakame/sdk": "^0.1.0",
    "@noble/hashes": "^2.4.0",
    "@perawallet/use-wallet-pera": "^1.0.0",
    "@txnlab/use-wallet": "^5.4.0",
    "@txnlab/use-wallet-defly": "^5.4.0",
    "@txnlab/use-wallet-exodus": "^5.4.0",
    "@txnlab/use-wallet-kmd": "^5.4.0",
    "@txnlab/use-wallet-react": "^5.4.0",
    "algosdk": "^3.0.0",
    "canonify": "^2.1.1",
    "notistack": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tslib": "^2.9.1"
  },
  "scripts": {
    "reclaim": "node --env-file-if-exists=.env.testnet --import tsx scripts/reclaim.ts",
    "dev:localnet": "vite --mode localnet",
    "dev:testnet": "vite --mode testnet",
    "build:localnet": "tsc && vite build --mode localnet",
    "build:testnet": "tsc && vite build --mode testnet",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "ws@>7.0.0 <7.5.9": "7.5.10"
  },
  "allowScripts": {
    "esbuild": true
  }
}
