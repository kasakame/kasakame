# LocalNet environment; bootstrap copies this to gitignored `.env.localnet` and the deploy prints the ids. Never keep network values in a base `.env`: Vite layers `.env.<mode>` on top of it.

VITE_ENVIRONMENT=local

# Algod
VITE_ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VITE_ALGOD_SERVER=http://localhost
VITE_ALGOD_PORT=4001
VITE_ALGOD_NETWORK=localnet

# Indexer
VITE_INDEXER_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VITE_INDEXER_SERVER=http://localhost
VITE_INDEXER_PORT=8980

# kasakame Registry app id (deployed by `algokit project deploy localnet`). Required: an empty id skips registration, so the vault rejects pledges and the campaign cannot be deleted.
VITE_REGISTRY_APP_ID=
# kasakame ClaimsVault app id (deployed by `algokit project deploy localnet`) - receives every pledge.
VITE_VAULT_APP_ID=

# Optional catalog backend (cover-image uploads); leave empty to disable.
VITE_BACKEND_URL=http://localhost:3001

# KMD - LocalNet only (other networks ignore the KMD provider); AlgoKit's default 'unencrypted-default-wallet' holds test tokens.
VITE_KMD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VITE_KMD_SERVER=http://localhost
VITE_KMD_PORT=4002
VITE_KMD_WALLET="unencrypted-default-wallet"
VITE_KMD_PASSWORD=""
