# TestNet environment. `algokit project bootstrap all` creates the matching `.env.testnet`
# (gitignored) from this file when it is missing; fill in the app ids printed by
# `algokit project deploy testnet`.
#
# Never keep network-specific values in a base `.env`: Vite loads `.env` first and
# `.env.<mode>` on top, and a stale base file is exactly how wrong app ids sneak in.

VITE_ENVIRONMENT=local

# Algod
VITE_ALGOD_TOKEN=""
VITE_ALGOD_SERVER="https://testnet-api.algonode.cloud"
VITE_ALGOD_PORT=""
VITE_ALGOD_NETWORK="testnet"

# Indexer
VITE_INDEXER_TOKEN=""
VITE_INDEXER_SERVER="https://testnet-idx.algonode.cloud"
VITE_INDEXER_PORT=""

# kasakame Factory app id (deployed to TestNet).
VITE_FACTORY_APP_ID=
# kasakame ClaimsVault app id (deployed to TestNet).
VITE_VAULT_APP_ID=

# Optional catalog backend (cover-image uploads); leave empty to disable.
VITE_BACKEND_URL=http://localhost:3001
