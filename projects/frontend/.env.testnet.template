# TestNet environment; bootstrap copies this to gitignored `.env.testnet` and the deploy prints the ids. Never keep network values in a base `.env`: Vite layers `.env.<mode>` on top of it.

VITE_ENVIRONMENT=local

# Algod
VITE_ALGOD_TOKEN=""
VITE_ALGOD_SERVER="https://testnet-api.algonode.cloud"
VITE_ALGOD_PORT=""
VITE_ALGOD_NETWORK="testnet"

# Indexer
VITE_INDEXER_TOKEN=""
VITE_INDEXER_SERVER="https://testnet-idx.algonode.cloud"
VITE_INDEXER_PORT=""

# kasakame Registry app id (deployed to TestNet). Required: an empty id skips registration, so the vault rejects pledges and the campaign cannot be deleted.
VITE_REGISTRY_APP_ID=
# kasakame ClaimsVault app id (deployed to TestNet) - receives every pledge.
VITE_VAULT_APP_ID=

# Optional catalog backend (cover-image uploads); leave empty to disable.
VITE_BACKEND_URL=http://localhost:3001
