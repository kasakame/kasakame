# Environment template. Copy to the file for the network you need:
#
#   cp .env.template .env.localnet   # npm run dev:localnet / npm run build:localnet
#   cp .env.template .env.testnet    # npm run dev:testnet / npm run build:testnet / npm run reclaim
#
# Never keep network-specific values in a general `.env`: Vite loads `.env` first and
# `.env.<mode>` on top, and a stale base file is exactly how wrong app ids sneak in.

# ======================
# LocalNet configuration (`.env.localnet`)
# ======================

VITE_ENVIRONMENT=local

# Algod
VITE_ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VITE_ALGOD_SERVER=http://localhost
VITE_ALGOD_PORT=4001
VITE_ALGOD_NETWORK=localnet

# Indexer
VITE_INDEXER_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VITE_INDEXER_SERVER=http://localhost
VITE_INDEXER_PORT=8980

# kasakame Factory app id (deployed by `algokit project deploy localnet`); leave empty to disable the official-campaign filter.
VITE_FACTORY_APP_ID=
# kasakame ClaimsVault app id (deployed by `algokit project deploy localnet`) - the pooled refund escrow.
VITE_VAULT_APP_ID=

# Optional catalog backend (cover-image uploads); leave empty to disable.
VITE_BACKEND_URL=http://localhost:3001

# KMD
# Please note:
# 1. This is only needed for LocalNet since
# by default KMD provider is ignored on other networks.
# 2. AlgoKit LocalNet starts with a single wallet called 'unencrypted-default-wallet',
# with heaps of tokens available for testing.
VITE_KMD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VITE_KMD_SERVER=http://localhost
VITE_KMD_PORT=4002
VITE_KMD_WALLET="unencrypted-default-wallet"
VITE_KMD_PASSWORD=""

# ======================
# TestNet configuration (`.env.testnet`)
# ======================

VITE_ENVIRONMENT=local

# Algod
VITE_ALGOD_TOKEN=""
VITE_ALGOD_SERVER="https://testnet-api.algonode.cloud"
VITE_ALGOD_PORT=""
VITE_ALGOD_NETWORK="testnet"

# Indexer
VITE_INDEXER_TOKEN=""
VITE_INDEXER_SERVER="https://testnet-idx.algonode.cloud"
VITE_INDEXER_PORT=""

# kasakame Factory app id (deployed to TestNet).
VITE_FACTORY_APP_ID=
# kasakame ClaimsVault app id (deployed to TestNet).
VITE_VAULT_APP_ID=

# Optional catalog backend (cover-image uploads); leave empty to disable.
VITE_BACKEND_URL=http://localhost:3001

# ======================
# MainNet configuration (`.env.mainnet` - mode `mainnet`, not wired up yet)
# ======================

VITE_ENVIRONMENT=production

# Algod
VITE_ALGOD_TOKEN=""
VITE_ALGOD_SERVER="https://mainnet-api.algonode.cloud"
VITE_ALGOD_PORT=""
VITE_ALGOD_NETWORK="mainnet"

# Indexer
VITE_INDEXER_TOKEN=""
VITE_INDEXER_SERVER="https://mainnet-idx.algonode.cloud"
VITE_INDEXER_PORT=""
